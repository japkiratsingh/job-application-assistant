{
  "name": "job-application-assistant",
  "version": "1.0.0",
  "main": "auto-apply-runner.js",
  "scripts": {
    "check": "node --check wellfound-auto-apply.js && node --check auto-apply-runner.js && node --check backfill-xlsx.js && node --check config.js",
    "wellfound:login": "node auto-apply-runner.js wellfound login",
    "wellfound:dry": "node auto-apply-runner.js wellfound",
    "wellfound:live": "node auto-apply-runner.js wellfound --live",
    "xlsx:backfill": "node backfill-xlsx.js"
  },
  "keywords": [
    "wellfound",
    "playwright",
    "automation"
  ],
  "author": "Japkirat Singh Lamba",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/japkiratsingh/job-application-assistant.git"
  },
  "license": "ISC",
  "description": "Playwright automation for applying to matching Wellfound jobs",
  "dependencies": {
    "exceljs": "^4.4.0",
    "playwright-core": "^1.61.1",
    "playwright-extra": "^4.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2"
  }
}
